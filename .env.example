# ZSL Order — konfiguracja wdrożeniowa.
# Ten plik zawiera wyłącznie ustawienia środowiska. NIE wpisuj tu haseł,
# tokenów ani innych sekretów — sekret JWT jest tworzony w pliku jwt.key.
#
# Plik .env jest ignorowany przez Git. Zmienne mają pierwszeństwo nad
# zgodnościowymi polami ip/port/secure_cookies w config.json.

# Tryb wdrożenia: local | tunnel
# local  — sieć szkolna, HTTP dozwolone, adres klienta z gniazda TCP.
# tunnel — wyłącznie za Cloudflare Tunnel, nasłuch na loopback.
DEPLOY_MODE=local

# Adres nasłuchu. W trybie tunnel dozwolone są tylko 127.0.0.1 i ::1.
# Przykłady: 0.0.0.0:8080, 127.0.0.1:3000, [::1]:3000
BIND_ADDR=0.0.0.0:3000

# Adresy proxy, którym wolno przekazać CF-Connecting-IP (tylko tunnel).
# Lista IP lub CIDR rozdzielona przecinkami. Domyślnie lokalne proxy.
TRUSTED_PROXIES=127.0.0.1,::1

# Publiczny adres aplikacji, np. https://zsl.example.com
# W trybie tunnel jest wymagany. Bez ścieżki, zapytania i danych logowania.
PUBLIC_URL=

# Flaga Secure dla ciasteczka sesji: auto | true | false
# auto  — true, gdy PUBLIC_URL używa https; inaczej false.
# W trybie tunnel zawsze wymuszane jest true.
COOKIE_SECURE=auto

# Katalog kopii zapasowych (względny wobec WorkingDirectory albo absolutny).
# Domyślnie backups/. Wpis zastępuje backup_dir z config.json.
# BACKUP_DIR=/var/backups/zsl

# Retencja kopii w dniach. Wpis zastępuje backup_keep_days z config.json.
# Niezależnie od wartości zawsze zachowywane jest 7 najnowszych kopii.
# BACKUP_KEEP_DAYS=30
